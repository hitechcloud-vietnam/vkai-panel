[Unit]
Description=VKAI Panel Frontend (Next.js)
After=network.target vkai-panel-api.service
Wants=network-online.target
Requires=vkai-panel-api.service

[Service]
Type=simple
User=vkai
Group=vkai
WorkingDirectory=/opt/vkai-panel/frontend
EnvironmentFile=/opt/vkai-panel/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/vkai-panel/frontend/server.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vkai-panel-frontend

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vkai-panel/frontend/.next
PrivateTmp=true

[Install]
WantedBy=multi-user.target
