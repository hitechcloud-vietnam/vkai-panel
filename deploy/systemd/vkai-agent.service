# =============================================================================
# VKAI Panel - node agent  |  HiTechCloud (hitechcloud.vn)
# Installed as: /etc/systemd/system/vkai-agent.service
#
# The agent collects system metrics and performs host level operations, which is
# why it runs as root. It is OPTIONAL: enable it with
# "systemctl enable --now vkai-agent".
#
# A native Go binary, NOT a container. Every path goes through the symlink
# /vkai-panel/current -> running release.
# =============================================================================
[Unit]
Description=VKAI Panel node agent
Documentation=https://github.com/hitechcloud-vietnam/vkai-panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/vkai-panel/current/agent
ExecStart=/vkai-panel/current/agent/bin/vkai-agent
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vkai-agent

EnvironmentFile=/vkai-panel/etc/.env

# --- Hardening ---------------------------------------------------------------
# The agent reads /proc and /sys to report resource usage, but must not write
# anywhere outside the panel directories.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
LockPersonality=true
ReadWritePaths=/vkai-panel/logs
ReadWritePaths=/vkai-panel/tmp
ReadWritePaths=/vkai-panel/www
# The agent's own key, certificate and copy of the panel CA. It is written on
# enrolment and rewritten on every rotation, so it must be writable, and it
# lives outside /vkai-panel/current so an upgrade does not take the identity
# with it. Override with VKAI_AGENT_STATE_DIR.
ReadWritePaths=/vkai-panel/ssl/agent

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
