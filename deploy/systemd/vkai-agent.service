# =============================================================================
# VKAI Panel - node agent  |  HiTechCloud (hitechcloud.vn)
# Installed as: /etc/systemd/system/vkai-agent.service
#
# The agent collects system metrics and performs host level operations, which is
# why it runs as root.
#
# On the machine the panel is installed on this unit is NOT optional: it is what
# makes that machine a managed node rather than an entry in a table. The
# installer enables and starts it through "vkai node register", which also mints
# the single-use token it enrols with. On any OTHER machine it is enabled by the
# operator after pasting an enrolment token minted in the panel.
#
# A native Go binary, NOT a container. Every path goes through the symlink
# /vkai-panel/current -> running release.
# =============================================================================
[Unit]
Description=VKAI Panel node agent
Documentation=https://github.com/hitechcloud-vietnam/vkai-panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/vkai-panel/current/agent
ExecStart=/vkai-panel/current/agent/bin/vkai-agent
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vkai-agent

EnvironmentFile=/vkai-panel/etc/.env
# The node's own settings: which panel to talk to, where its identity lives and,
# for the few seconds between minting and spending, the enrolment token. It is a
# SEPARATE file because the installer rewrites .env wholesale on every run and
# this must survive that. Written by "vkai node register". The leading "-" keeps
# the agent startable on a machine that has not been registered yet, where the
# only thing it can do is say so.
EnvironmentFile=-/vkai-panel/etc/agent.env

# --- Hardening ---------------------------------------------------------------
# The agent reads /proc and /sys to report resource usage, but must not write
# anywhere outside the panel directories.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
LockPersonality=true
ReadWritePaths=/vkai-panel/logs
ReadWritePaths=/vkai-panel/tmp
ReadWritePaths=/vkai-panel/www
# The agent's own key, certificate and copy of the panel CA. It is written on
# enrolment and rewritten on every rotation, so it must be writable, and it
# lives outside /vkai-panel/current so an upgrade does not take the identity
# with it. Override with VKAI_AGENT_STATE_DIR.
#
# The "-" matters: systemd refuses to start a unit whose ReadWritePaths names a
# path that does not exist, and this directory is created at registration time.
# Without it a machine that has never been registered cannot even start the
# agent to be told why. "vkai node register" creates the directory before it
# starts the unit, so the writable mount is there when it is needed.
ReadWritePaths=-/vkai-panel/ssl/agent

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
