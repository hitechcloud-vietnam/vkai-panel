# =============================================================================
# VKAI Panel - Next.js UI  |  HiTechCloud (hitechcloud.vn)
# Installed as: /etc/systemd/system/vkai-ui.service
#
# Runs the "standalone" build under a native node, NOT a container.
# The build MUST copy .next/static and public/ into .next/standalone
# (npm run build does it through postbuild:standalone). Without that copy the
# page returns HTML while every /_next/static/*.js returns 404 and the browser
# shows "Application error: a client-side exception has occurred".
#
# Every path goes through the symlink /vkai-panel/current -> running release.
# =============================================================================
[Unit]
Description=VKAI Panel UI (Next.js standalone)
Documentation=https://github.com/hitechcloud-vietnam/vkai-panel
After=network-online.target vkai-api.service
Wants=network-online.target vkai-api.service

[Service]
Type=simple
User=vkai
Group=vkai
WorkingDirectory=/vkai-panel/current/panel
ExecStart=/usr/bin/node /vkai-panel/current/panel/.next/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vkai-ui

# Defaults; .env is loaded afterwards and therefore wins.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/vkai-panel/etc/.env

# --- Hardening ---------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Next.js writes a cache and logs; the UI sources are read only. The leading
# "-": a fresh release has no .next/cache yet, and a missing path must not stop
# the service from starting.
ReadWritePaths=-/vkai-panel/current/panel/.next/cache
ReadWritePaths=/vkai-panel/logs
ReadWritePaths=/vkai-panel/tmp

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
