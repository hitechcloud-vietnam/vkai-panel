# ===========================================================================
# VKAI Panel — biến môi trường mẫu (HiTechCloud — hitechcloud.vn)
# ---------------------------------------------------------------------------
# Sao chép tệp này thành .env rồi điền giá trị thật:
#
#   cp .env.example .env && chmod 600 .env
#
# BẢO MẬT: mọi biến ghi "BẮT BUỘC" đều KHÔNG có giá trị mặc định. Panel từ chối
# khởi động nếu thiếu, thay vì chạy bằng một giá trị đã công bố trong kho mã.
# Sinh khoá thật trước lần chạy đầu tiên:
#
#   openssl rand -hex 32     # VKAI_JWT_SECRET, VKAI_SECRET_KEY
#   openssl rand -base64 24  # VKAI_DB_PASSWORD, VKAI_REDIS_PASSWORD, VKAI_AGENT_TOKEN
#
# Giữ tệp .env ở chế độ 0600 và thuộc sở hữu của người dùng hệ thống "vkai".
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. CỔNG TRUY CẬP PANEL (mô hình aaPanel)
# ---------------------------------------------------------------------------
# Panel KHÔNG BAO GIỜ trả lời trên cổng 80/443: hai cổng đó dành riêng cho
# website của khách hàng. Panel nghe trên cổng riêng, phía sau một "lối vào an
# toàn" (đường dẫn bí mật), và tuỳ chọn thêm danh sách IP được phép.
#
# Hướng dẫn đầy đủ: docs/PANEL_ACCESS.md

# Cổng của panel. 8888 là mặc định tương thích aaPanel. Giá trị 80/443 bị từ chối.
VKAI_PANEL_PORT=8888

# Cạc mạng panel lắng nghe. Dùng 127.0.0.1 khi có reverse proxy trên cùng máy
# chủ công bố cổng panel; dùng 0.0.0.0 để truy cập trực tiếp.
VKAI_PANEL_BIND=0.0.0.0

# Lối vào an toàn: tiền tố đường dẫn bí mật, ví dụ https://IP:8888/vkai_a1b2c3d4/
# Để TRỐNG ở lần chạy đầu tiên, hệ thống sẽ tự sinh, ghi vào
# /vkai-panel/etc/panel_access.json và in ra một lần trong banner khởi động.
# Mọi truy cập không đi qua lối vào này đều nhận 404 trung tính.
VKAI_PANEL_ENTRANCE=
VKAI_PANEL_ENTRANCE_ENABLED=true

# Thời gian hiệu lực của cookie sau khi đi qua lối vào an toàn.
VKAI_PANEL_SESSION_TTL=12h

# Sinh cổng ngẫu nhiên thay cho 8888 ở lần khởi động đầu tiên.
VKAI_PANEL_RANDOM_PORT=false

# Danh sách IP/CIDR được phép truy cập panel, ngăn cách bằng dấu phẩy.
# ĐỂ TRỐNG = cho phép tất cả. Ví dụ: 203.0.113.7,10.0.0.0/8
VKAI_PANEL_ALLOWED_IPS=

# Chỉ tin header X-Forwarded-For khi đến từ các địa chỉ này. Để TRỐNG khi panel
# được truy cập trực tiếp: nếu không, bất kỳ client nào cũng có thể giả mạo một
# địa chỉ nằm trong danh sách cho phép chỉ bằng cách tự gửi header.
# Khi chạy bằng docker-compose (nginx đứng trước): 172.16.0.0/12
VKAI_PANEL_TRUSTED_PROXIES=

# Ghim panel vào đúng một tên miền. Khi đặt giá trị, request có Host khác sẽ
# nhận cùng một 404 trung tính.
VKAI_PANEL_DOMAIN=

# Chứng chỉ TLS RIÊNG của panel, độc lập hoàn toàn với chứng chỉ website khách.
# Đặt cả hai đường dẫn cho chứng chỉ thật, hoặc bật SELF_SIGNED để tự sinh vào
# /vkai-panel/ssl/panel.crt|.key ở lần khởi động đầu.
VKAI_PANEL_TLS_CERT=
VKAI_PANEL_TLS_KEY=
VKAI_PANEL_TLS_SELF_SIGNED=false

# Nơi lưu cổng/lối vào đã sinh (chế độ 0600).
VKAI_PANEL_CONFIG_FILE=/vkai-panel/etc/panel_access.json


# ---------------------------------------------------------------------------
# 2. ĐƯỜNG DẪN CHUẨN TRÊN MÁY CHỦ
# ---------------------------------------------------------------------------
# /vkai-panel/                      gốc cài đặt panel
# /vkai-panel/core/                 mã/binary API
# /vkai-panel/panel/                bản build giao diện
# /vkai-panel/www/domains/<domain>  MÃ NGUỒN WEBSITE của khách
# /vkai-panel/www/backup/           sao lưu website/CSDL
# /vkai-panel/www/default/          trang mặc định
# /vkai-panel/logs/                 nhật ký panel
# /vkai-panel/logs/sites/<domain>/  nhật ký web server theo site
# /vkai-panel/etc/                  cấu hình panel (.env, config.yaml)
# /vkai-panel/ssl/                  chứng chỉ
# /vkai-panel/tmp/                  tạm

VKAI_PANEL_ROOT=/vkai-panel
VKAI_WEB_ROOT=/vkai-panel/www/domains
VKAI_LOG_ROOT=/vkai-panel/logs
VKAI_SSL_ROOT=/vkai-panel/ssl
VKAI_TMP_ROOT=/vkai-panel/tmp

# Trình quản lý tệp bị nhốt trong thư mục này. KHÔNG BAO GIỜ đặt là "/": phục vụ
# toàn bộ hệ thống tệp qua API tương đương trao quyền root từ xa.
VKAI_FILEMANAGER_ROOT=/vkai-panel/www/domains

# Đích sao lưu gửi qua API phải nằm trong thư mục gốc này.
VKAI_BACKUP_ROOT=/vkai-panel/www/backup


# ---------------------------------------------------------------------------
# 3. MÁY CHỦ API (core/)
# ---------------------------------------------------------------------------
# server.host/server.port chỉ được dùng khi TẮT cổng truy cập panel
# (VKAI_PANEL_ENABLED=false). Ngược lại panel nghe trên
# VKAI_PANEL_BIND:VKAI_PANEL_PORT.
VKAI_PANEL_ENABLED=true
VKAI_SERVER_HOST=127.0.0.1
VKAI_SERVER_PORT=30110
VKAI_SERVER_MODE=release


# ---------------------------------------------------------------------------
# 4. CƠ SỞ DỮ LIỆU (PostgreSQL)
# ---------------------------------------------------------------------------
# Khi chạy bằng docker-compose, VKAI_DB_HOST là tên dịch vụ "postgres".
VKAI_DB_HOST=localhost
VKAI_DB_PORT=5432
VKAI_DB_USER=vkai
# BẮT BUỘC — không có mặc định. Không được để trống hay đặt "vkai_secret".
VKAI_DB_PASSWORD=
VKAI_DB_NAME=vkai_panel
# "require" hoặc mạnh hơn. "disable" chỉ chấp nhận với CSDL trên localhost.
VKAI_DB_SSLMODE=require


# ---------------------------------------------------------------------------
# 5. REDIS
# ---------------------------------------------------------------------------
# Khi chạy bằng docker-compose, VKAI_REDIS_HOST là tên dịch vụ "redis".
VKAI_REDIS_HOST=localhost
VKAI_REDIS_PORT=6379
# BẮT BUỘC khi chạy docker-compose (redis khởi động với --requirepass).
VKAI_REDIS_PASSWORD=
VKAI_REDIS_DB=0


# ---------------------------------------------------------------------------
# 6. XÁC THỰC & MÃ HOÁ
# ---------------------------------------------------------------------------
# BẮT BUỘC — không có mặc định. Tối thiểu 32 ký tự ngẫu nhiên và KHÔNG được
# chứa các từ mẫu như "change" hay "example": panel kiểm tra lúc khởi động và
# thoát nếu khoá yếu. Đổi khoá này sẽ vô hiệu mọi access/refresh token đã cấp.
VKAI_JWT_SECRET=
VKAI_JWT_ACCESS_EXPIRY=15
VKAI_JWT_REFRESH_EXPIRY=10080
VKAI_JWT_ISSUER=vkai-panel

# BẮT BUỘC để tạo hoặc xoay vòng người dùng CSDL do panel quản lý. 32 byte mã
# hoá hex (64 ký tự) hoặc base64. Dùng để mã hoá mật khẩu CSDL lưu trữ; thiếu
# khoá này thì các thao tác đó thất bại thay vì lưu ở dạng văn bản thuần.
VKAI_SECRET_KEY=

# Kiểm tra quyền (RBAC) được cưỡng chế mặc định. Chỉ đặt "false" như một bước
# chuyển đổi tạm thời trên hệ thống chưa nạp dữ liệu bảng user_roles — nó tắt
# TOÀN BỘ kiểm tra phân quyền.
VKAI_RBAC_ENFORCE=true

# Danh sách origin trình duyệt được phép gọi API, ngăn cách bằng dấu phẩy.
# Không có ký tự đại diện: danh sách rỗng nghĩa là chặn hoàn toàn cross-origin.
VKAI_CORS_ALLOWED_ORIGINS=


# ---------------------------------------------------------------------------
# 7. AGENT (agent/)
# ---------------------------------------------------------------------------
VKAI_AGENT_PORT=30111
# BẮT BUỘC — không có mặc định. Bí mật chia sẻ giữa panel và agent.
VKAI_AGENT_TOKEN=


# ---------------------------------------------------------------------------
# 8. CRON & NHẬT KÝ
# ---------------------------------------------------------------------------
# Tài khoản chạy các cron job do panel quản lý. Không chạy bằng root.
VKAI_CRON_USER=www-data

VKAI_LOG_LEVEL=info
VKAI_LOG_FORMAT=json


# ---------------------------------------------------------------------------
# 9. GIAO DIỆN PANEL (panel/ — Next.js)
# ---------------------------------------------------------------------------
# CẢNH BÁO: NEXT_PUBLIC_* được NHÚNG THẲNG VÀO BUNDLE LÚC BUILD, không phải lúc
# chạy. Cấp biến sau khi đã `npm run build` (hoặc chỉ đặt ở "environment" của
# docker-compose) sẽ KHÔNG có tác dụng — bundle mang chuỗi rỗng. Vì vậy
# docker-compose.yml truyền biến này qua build.args, và panel/Dockerfile khai
# báo ARG + ENV trước bước `npm run build`.
#
# Giá trị phải là URL mà TRÌNH DUYỆT truy cập được:
#   - ĐỂ TRỐNG (khuyến nghị): giao diện gọi same-origin qua reverse proxy của
#     panel, ví dụ https://panel.example.com:8888/api/v1/...
#   - Đặt URL tuyệt đối chỉ khi giao diện và API nằm ở hai tên miền/cổng khác
#     nhau, ví dụ: https://panel.example.com:8888
#
# TUYỆT ĐỐI không dùng hostname nội bộ của Docker như http://vkai-core:30110:
# trình duyệt của người dùng không phân giải được tên đó.
NEXT_PUBLIC_API_URL=
