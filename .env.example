# vKAI Panel Environment Variables

# Server
VKAI_SERVER_HOST=0.0.0.0
VKAI_SERVER_PORT=30110
VKAI_SERVER_MODE=debug

# Database
VKAI_DB_HOST=localhost
VKAI_DB_PORT=5432
VKAI_DB_USER=vkai
VKAI_DB_PASSWORD=vkai_password
VKAI_DB_NAME=vkai_panel
VKAI_DB_SSLMODE=disable

# Redis
VKAI_REDIS_HOST=localhost
VKAI_REDIS_PORT=6379
VKAI_REDIS_PASSWORD=
VKAI_REDIS_DB=0

# JWT
VKAI_JWT_SECRET=change-this-to-a-random-secret-key
VKAI_JWT_ACCESS_EXPIRY=15
VKAI_JWT_REFRESH_EXPIRY=10080

# Agent
VKAI_AGENT_PORT=30111
VKAI_AGENT_TOKEN=your-agent-token-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:30110
