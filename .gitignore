# vKAI Panel .gitignore

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Logs
*.log
logs/
log/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Core API (Go) - core/
core/bin/
core/vendor/
core/tmp/
core/logs/
core/config.yaml
core/config.local.yaml
core/coverage.out
core/coverage.html
core/.panel_access.json
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# Panel UI (Next.js) - panel/
panel/node_modules/
panel/.next/
panel/out/
panel/build/
panel/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Agent
agent/vendor/
agent/tmp/
agent/bin/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
docker/data/
docker-compose.override.yml

# SSL certificates
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Backup files
*.bak
*.backup
*.old

# Test coverage
coverage/
*.cover
.coverage
htmlcov/

# Database
*.db
*.sqlite
*.sqlite3

# Build artifacts
dist/
build/
output/

# Cache
.cache/
*.cache

# Archives
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# Executables
*.exe
*.dll
*.so
*.dylib
*.app
*.deb
*.rpm
*.msi
*.dmg

# Compiled
*.class
*.pyc
*.pyo
__pycache__/

# Binary da build nam ngay tai goc thu muc ma nguon
core/api
core/vkai-api
core/vkai-cli
core/vkai-panelctl
agent/vkaid
agent/vkai-agent

# Thu muc lam viec cua ban phat trien
.dev/

# ── Khoá và bí mật (KHÔNG BAO GIỜ commit) ───────────────────────────────────
# Khoá mã hoá mã nguồn của vkai-crypt. Mất khoá = mất mã nguồn đã đẩy lên.
.vkai/
*.key
*.key.txt
*.pem
vkai-repo.key
install-summary.txt
secrets/
*.jks
*.keystore
credentials.json
service-account*.json

# ── Sản phẩm build và bản phát hành ─────────────────────────────────────────
dist/
release/
bin/
# Chi binary o goc, khong dinh vao thu muc ma nguon cung ten
/tools/protect/vkai-crypt
/vkai-crypt
/vkai-api
/vkai-agent
*.jsc
SHA256SUMS

# ── Phụ thuộc và cache của trình dựng ───────────────────────────────────────
node_modules/
.next/
.turbo/
.eslintcache
.swc/
vendor/
.pnpm-store/
.yarn/cache/

# ── Runtime ─────────────────────────────────────────────────────────────────
*.pid
*.sock
*.seed
.pids/

# ── Xung đột merge và bản vá ────────────────────────────────────────────────
*.orig
*.rej
*.patch.bak

# ── Môi trường phát triển cục bộ ────────────────────────────────────────────
.envrc
.direnv/
.tool-versions.local
reference/
